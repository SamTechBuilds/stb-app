<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only. STB Core (Supabase) is reached over TLS with the system's trusted CAs. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
